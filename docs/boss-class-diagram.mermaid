    class HudStatusIcons {
        <<T2 布局零改动>>
        +const float IconSize = 34
        +void Build(Transform canvasRoot) @95
    }
    note for HudStatusIcons "★ GAP-8 冲突源：@105-106 目标状态行<br/>   anchor(0.5, 1) · offset(0, -28) · size 294x34<br/>   → 占据顶部中央 距顶 28~62、x ∈ [-147, +147]<br/><br/>原方案「血条距顶 40」会与之纵向重叠 22px、横向完全覆盖，<br/>导致打 BOSS 时看不到目标 DEBUFF —— 而那恰是最需要看的时候。<br/>决策：让新组件（血条）下移到 72，既有布局零改动。"

    class HudBossBar {
        <<T2新增 MonoBehaviour>>
        -RectTransform _root
        -Text _nameText
        -RectTransform _barBg
        -RectTransform _fill
        -Combatant _boss
        -bool _built
        -bool _shown
        +bool IsBuilt
        +bool IsShown
