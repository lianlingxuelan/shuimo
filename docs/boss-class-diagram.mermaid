        +static Text NewText(...)
        +static RectTransform NewRect(...)
        -void Build() @132
        -void BuildHpBar(Transform) @203
        -void BuildTopRight(Transform) @354
        -void BuildCombo(Transform) @191
        -void BuildT3Widgets(Transform) @171
